# ERP EnterpriseCloud - Variables de Entorno
# Copiar este archivo como .env y completar los valores reales de AWS

# ================================================
# BASE DE DATOS
# ================================================
# SQLite (desarrollo local sin configuración adicional):
DATABASE_URL=sqlite:///./erp_enterprisecloud.db

# PostgreSQL en Amazon RDS (producción AWS):
# DATABASE_URL=postgresql://erpadmin:password@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/erp_enterprisecloud

# ================================================
# SEGURIDAD & JWT
# ================================================
SECRET_KEY=erp_enterprisecloud_secret_key_2026_change_in_production_256bits
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ================================================
# AMAZON S3 - GESTIÓN DOCUMENTAL CLOUD
# ================================================
# Modo local (NO requiere credenciales AWS, usa carpeta ./uploads):
USE_S3_STORAGE=false

# Modo cloud real (AWS S3):
# USE_S3_STORAGE=true
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=erp-enterprisecloud-documents
